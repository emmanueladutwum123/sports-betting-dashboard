# Streamlit secrets template.
#
# LOCAL:  copy this file to .streamlit/secrets.toml and paste your key below
#         (or just use a .env file — see .env.example; either works).
# CLOUD:  do NOT commit a real key. On share.streamlit.io open your app's
#         ⋮ menu → Settings → Secrets and paste the line below with your key.
#
# Free key (500 requests/month, no credit card): https://the-odds-api.com

ODDS_API_KEY = "your_key_here"
